# Copy this file to `.env` and adjust for your environment.

# --- General ---
APP_NAME=Zeviq AI RAG API
DEBUG=true

# --- Networking ---
HOST=0.0.0.0
PORT=8000
# Comma separated list of allowed origins. Use a real domain in production.
CORS_ORIGINS=*

# --- Security (CHANGE THESE IN PRODUCTION) ---
SECRET_KEY=please-change-me-to-a-long-random-string-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_TEMPERATURE=0.2
DEFAULT_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Uploads ---
MAX_UPLOAD_MB=50

# --- Rate limiting (chat and grade endpoints) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Academic grading RAG ---
# Higher-capacity embeddings for curriculum + grading memory (chat keeps EMBEDDING_MODEL).
GRADING_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true

CURRICULUM_COLLECTION=curriculum_kb
GRADING_MEMORY_COLLECTION=grading_memory_kb
CHAT_COLLECTION=langchain

IN_SYLLABUS_THRESHOLD=70
PARTIALLY_RELATED_THRESHOLD=50
GRADE_TOP_K=5
GRADE_RERANK_TOP_N=5
CALIBRATION_EXAMPLE_COUNT=3

CURRICULUM_CHUNK_SIZE=800
CURRICULUM_CHUNK_OVERLAP=100

SHOW_DRAFT_FEEDBACK=true
ENABLE_GRADE_CACHE=true

# --- Paths (optional overrides; default to the project root) ---
# DATA_DIR=../data
# CHROMA_DIR=../chroma_db
# CURRICULUM_DIR=../data/curriculum
# GRADING_DIR=../data/grading
